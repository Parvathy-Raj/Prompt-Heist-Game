# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# gpt-oss models only: how long the model thinks before answering (low/medium/high)
GROQ_REASONING_EFFORT=low
# Defaults to GROQ_MODEL when empty
GROQ_GUARD_MODEL=
GROQ_RPM=25

# Level 3 similarity threshold (benchmark tunes this on the dev split)
ARENA_SIM_THRESHOLD=0.6
# "st" = sentence-transformers all-MiniLM-L6-v2, "fuzzy" = offline rapidfuzz fallback
ARENA_EMBEDDER=st
# Public demo quota protection
ARENA_SESSION_MSG_CAP=20
ARENA_IP_RATE_PER_MIN=10
ARENA_IP_DAILY_CAP=200
ARENA_MAX_INPUT_CHARS=1000
ARENA_DB_PATH=arena.sqlite3
ARENA_CACHE_DIR=cache
